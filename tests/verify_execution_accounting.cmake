cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
foreach(mode IN ITEMS native_clock core_clock core_entry)
    set(clock)
    if(mode STREQUAL core_clock)
        set(clock --emulated-scheduler)
    elseif(mode STREQUAL core_entry)
        set(clock --emulated-boundary)
    endif()
    execute_process(COMMAND "${APP}" --record-gameplay-alley "${OUTPUT}.${mode}.csv"
        --replace-registry --instruction-profile "${OUTPUT}.${mode}.profile.csv"
        --report-boundary-coverage ${clock} --rom "${ROM}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(WRITE "${OUTPUT}.${mode}.log" "${output}${errors}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Accounting replay failed: ${status}; ${errors}")
    endif()
    file(SHA256 "${OUTPUT}.${mode}.csv" hash)
    if(NOT hash STREQUAL "964c9e6d67eaf95d75188faa22f52f9aba1016ce19f74f22b2f5f11dfd604d58")
        message(FATAL_ERROR "Accounting changed the pre-existing alley frame oracle")
    endif()
    string(REGEX MATCH "Execution cycles: elapsed=([0-9]+); accounted=([0-9]+); unaccounted=0" ledger "${output}")
    if(NOT ledger OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Execution ledger does not reconcile: ${output}")
    endif()
    set(elapsed "${CMAKE_MATCH_1}")
    string(REGEX MATCH "Execution ownership:[^\r\n]+" owners "${output}")
    set(sum 0)
    foreach(owner IN ITEMS translated retained fallback interrupt idle device other)
        string(REGEX MATCH "${owner}=([0-9]+)" value "${owners}")
        if(NOT value)
            message(FATAL_ERROR "Missing clock owner: ${owner}")
        endif()
        set(${owner} "${CMAKE_MATCH_1}")
        math(EXPR sum "${sum} + ${${owner}}")
        if(NOT "${owner}" STREQUAL "other" AND NOT "${owner}" STREQUAL "interrupt" AND ${${owner}} EQUAL 0)
            message(FATAL_ERROR "Accounting failed to exercise ${owner}")
        endif()
    endforeach()
    if(NOT sum EQUAL elapsed OR NOT other EQUAL 0)
        message(FATAL_ERROR "Owner partition mismatch or unidentified clock movement")
    endif()
    math(EXPR working "${elapsed} - ${idle} - ${device}")
    string(FIND "${output}" "Native execution outside wait/stalls: ${translated} of ${working}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Coverage denominator includes waits/stalls")
    endif()
    string(REGEX MATCH "Core interrupt entries: ([0-9]+)" entries "${output}")
    set(core_entries "${CMAKE_MATCH_1}")
    math(EXPR irq_cycles "${CMAKE_MATCH_1} * 24")
    if(NOT irq_cycles EQUAL interrupt)
        message(FATAL_ERROR "IRQ-entry accounting differs from the independent boundary count")
    endif()
    string(REGEX MATCH "Native interrupt entries: ([0-9]+)" native_entries "${output}")
    set(native_count "${CMAKE_MATCH_1}")
    if(mode STREQUAL core_entry)
        if(NOT core_entries EQUAL 266641 OR NOT native_count EQUAL 0)
            message(FATAL_ERROR "Core IRQ entry oracle was not exercised")
        endif()
    else()
        if(NOT core_entries EQUAL 0 OR NOT native_count EQUAL 266641 OR NOT interrupt EQUAL 0)
            message(FATAL_ERROR "Native boundary retained core IRQ entry work")
        endif()
        string(REGEX MATCH "vectors: [0-9]+ reset, ([0-9]+) timer [(][^\r\n]+[)], ([0-9]+) irq1, ([0-9]+) irq2" vectors "${output}")
        math(EXPR boundary_count "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} + ${CMAKE_MATCH_3}")
        if(NOT vectors OR NOT boundary_count EQUAL native_count)
            message(FATAL_ERROR "Native IRQ entries disagree with boundary model")
        endif()
    endif()
    file(READ "${OUTPUT}.${mode}.profile.csv.interpreter.csv" residue)
    # The original engine remains visible on the core oracle. Native block
    # moves, like the translated indirect load, have no interpreter interval.
    if((mode STREQUAL core_entry AND NOT residue MATCHES "00,EB46,29,")
       OR (NOT mode STREQUAL core_entry AND residue MATCHES "00,EB46,")
       OR residue MATCHES "09,62E0,")
        message(FATAL_ERROR "Residue classification did not follow actual core disposition")
    endif()
    string(REGEX MATCH "Original opcode dispatches:[^\r\n]+" dispatches "${output}")
    string(REGEX MATCH "Native block moves: TIA=([0-9]+); TAI=([0-9]+); TDD=([0-9]+); TII=([0-9]+); TIN=([0-9]+); resumes=([0-9]+); CPU cycles=([0-9]+)" blocks "${output}")
    if(NOT blocks)
        message(FATAL_ERROR "Missing native block-move accounting")
    endif()
    set(block_cycles "${CMAKE_MATCH_7}")
    math(EXPR block_starts "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} + ${CMAKE_MATCH_3} + ${CMAKE_MATCH_4} + ${CMAKE_MATCH_5}")
    if(mode STREQUAL core_entry)
        if(NOT block_cycles EQUAL 0 OR NOT block_starts EQUAL 0)
            message(FATAL_ERROR "Core transfer oracle was bypassed")
        endif()
    elseif(block_cycles EQUAL 0 OR block_starts EQUAL 0)
        message(FATAL_ERROR "Native block transfers were not exercised")
    endif()
    string(REGEX MATCH "Native bit branches: instructions=([0-9]+); CPU cycles=([0-9]+)" branches "${output}")
    if(NOT branches)
        message(FATAL_ERROR "Missing native bit-branch accounting")
    endif()
    set(branch_starts "${CMAKE_MATCH_1}")
    set(branch_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT branch_starts EQUAL 0 OR NOT branch_cycles EQUAL 0)
            message(FATAL_ERROR "Core bit-branch oracle was bypassed")
        endif()
    elseif(branch_starts EQUAL 0 OR branch_cycles EQUAL 0 OR residue MATCHES "00,F423,")
        message(FATAL_ERROR "Native bit branches were not executed/classified")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${branch_cycles}")
    math(EXPR block_starts "${block_starts} + ${branch_starts}")
    string(REGEX MATCH "Native control flow: instructions=([0-9]+); CPU cycles=([0-9]+)" controls "${output}")
    if(NOT controls)
        message(FATAL_ERROR "Missing native control-flow accounting")
    endif()
    set(control_starts "${CMAKE_MATCH_1}")
    set(control_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT control_starts EQUAL 0 OR NOT control_cycles EQUAL 0)
            message(FATAL_ERROR "Core control-flow oracle was bypassed")
        endif()
    elseif(control_starts EQUAL 0 OR control_cycles EQUAL 0)
        message(FATAL_ERROR "Native control flow was not exercised")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${control_cycles}")
    math(EXPR block_starts "${block_starts} + ${control_starts}")
    string(REGEX MATCH "Native load/status: instructions=([0-9]+); CPU cycles=([0-9]+)" load_status "${output}")
    if(NOT load_status)
        message(FATAL_ERROR "Missing native load/status accounting")
    endif()
    set(load_status_starts "${CMAKE_MATCH_1}")
    set(load_status_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT load_status_starts EQUAL 0 OR NOT load_status_cycles EQUAL 0)
            message(FATAL_ERROR "Core load/status oracle was bypassed")
        endif()
    elseif(load_status_starts EQUAL 0 OR load_status_cycles EQUAL 0)
        message(FATAL_ERROR "Native load/status was not exercised")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${load_status_cycles}")
    math(EXPR block_starts "${block_starts} + ${load_status_starts}")
    string(REGEX MATCH "Native branches: instructions=([0-9]+); CPU cycles=([0-9]+)" branch "${output}")
    if(NOT branch)
        message(FATAL_ERROR "Missing native branches accounting")
    endif()
    set(branch_starts "${CMAKE_MATCH_1}")
    set(branch_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT branch_starts EQUAL 0 OR NOT branch_cycles EQUAL 0)
            message(FATAL_ERROR "Core branches oracle was bypassed")
        endif()
    elseif(branch_starts EQUAL 0 OR branch_cycles EQUAL 0)
        message(FATAL_ERROR "Native branches were not exercised")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${branch_cycles}")
    math(EXPR block_starts "${block_starts} + ${branch_starts}")
    string(REGEX MATCH "Native stores: instructions=([0-9]+); CPU cycles=([0-9]+)" store "${output}")
    if(NOT store)
        message(FATAL_ERROR "Missing native stores accounting")
    endif()
    set(store_starts "${CMAKE_MATCH_1}")
    set(store_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT store_starts EQUAL 0 OR NOT store_cycles EQUAL 0)
            message(FATAL_ERROR "Core stores oracle was bypassed")
        endif()
    elseif(store_starts EQUAL 0 OR store_cycles EQUAL 0)
        message(FATAL_ERROR "Native stores were not exercised")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${store_cycles}")
    math(EXPR block_starts "${block_starts} + ${store_starts}")
    string(REGEX MATCH "Native loads: instructions=([0-9]+); CPU cycles=([0-9]+)" load "${output}")
    if(NOT load)
        message(FATAL_ERROR "Missing native loads accounting")
    endif()
    set(load_starts "${CMAKE_MATCH_1}")
    set(load_cycles "${CMAKE_MATCH_2}")
    if(mode STREQUAL core_entry)
        if(NOT load_starts EQUAL 0 OR NOT load_cycles EQUAL 0)
            message(FATAL_ERROR "Core loads oracle was bypassed")
        endif()
    elseif(load_starts EQUAL 0 OR load_cycles EQUAL 0)
        message(FATAL_ERROR "Native loads were not exercised")
    endif()
    math(EXPR block_cycles "${block_cycles} + ${load_cycles}")
    math(EXPR block_starts "${block_starts} + ${load_starts}")
    # Native transfers must remove exactly their measured exclusive CPU time
    # from original execution. Device stalls and all other CPU work stay fixed.
    math(EXPR cpu_native_plus_irq "${translated} + ${interrupt} - ${block_cycles}")
    math(EXPR original_plus_blocks "${retained} + ${fallback} + ${block_cycles}")
    set(owners "${cpu_native_plus_irq};${original_plus_blocks};${idle};${device};${other}")
    string(REGEX MATCH "retained=([0-9]+); fallback=([0-9]+); idle=([0-9]+)" counts "${dispatches}")
    math(EXPR total_dispatches "${CMAKE_MATCH_1} + ${CMAKE_MATCH_2} + ${CMAKE_MATCH_3} + ${block_starts}")
    if(mode STREQUAL native_clock)
        set(expected_owners "${owners}")
        set(expected_dispatches "${total_dispatches}")
    elseif(NOT owners STREQUAL expected_owners OR NOT total_dispatches STREQUAL expected_dispatches)
        message(FATAL_ERROR "Native and original scheduler accounting differ")
    endif()
endforeach()
message(STATUS "Native/core IRQ and block engines, both schedulers, exclusive ledger and frame oracle agree")
