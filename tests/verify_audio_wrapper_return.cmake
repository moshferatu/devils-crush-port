# Compare audio wrapper return with assembly, including scheduler call observations.
set(expected_calls.csv "fb0e7861c4525389e78054be11a5b2c92e31dc13cbc1f849936c7d4e8e52b3da")
set(expected_calls.csv.writes.csv "3217845943d7cdb618f0f5e7766fb6581f2a5975f5ccd8359a60bc6934d94326")
set(expected_csv "1f6d46ac99798bbac1ecab97702d9e10076b9766796cc64d22d9662efce0b353")
set(expected_writes.csv "da606d14dd48b5b73e86096ba4033c6bf40c67e97ea771e5705760a02bbe3e1c")
set(expected_bus.csv "e1dcf4b4a41dcf07638356bfddf934265291648adef9022ff4799f716e5e7a46")
foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" gate_bytes OFFSET 306052 LIMIT 2 HEX)
if(NOT gate_bytes STREQUAL "2860")
    message(FATAL_ERROR "Unsupported audio wrapper return ROM instructions")
endif()
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "45:4B85@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay "${base}.csv" ${hooks}
        --observe-hook "01:C693" --observe-hook "01:C696" --observe-hook "01:C5EA" --observe-hook "01:C5C9"
        --routine-call-trace "${base}.calls.csv"
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Audio wrapper return ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        foreach(expected IN ITEMS "Native replacement 45:4B85@all entries: 8 of 26")
            string(FIND "${output}" "${expected}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing admission ${expected}: ${output}")
            endif()
            message(STATUS "${expected}")
        endforeach()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement)
        message(FATAL_ERROR "Audio wrapper return ${suffix}: ${original} != ${replacement}")
    endif()
    message(STATUS "${suffix}: ${original}")
    if(NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Audio wrapper return ${suffix} assembly baseline changed: ${original}")
    endif()
endforeach()

# PLP can restore I clear while an interrupt request is already pending.
# This registry route caught the missing RTS sample at frame 2277.
foreach(mode IN ITEMS before after)
    set(exclusions)
    if(mode STREQUAL "before")
        set(exclusions --registry-exclude "45:4B85")
    endif()
    execute_process(COMMAND "${APP}" --record-gameplay-stagger "${OUTPUT}.stagger.${mode}.csv"
        --replace-registry ${exclusions} --rom "${ROM}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Audio return stagger ${mode}: ${output}${error}")
    endif()
    file(SHA256 "${OUTPUT}.stagger.${mode}.csv" hash)
    if(NOT hash STREQUAL "a0ea079eeaaefd926b2523bc4a27380c6a24fb9c489db83c7d20b4174e781a40")
        message(FATAL_ERROR "Audio return stagger ${mode} state changed: ${hash}")
    endif()
endforeach()
