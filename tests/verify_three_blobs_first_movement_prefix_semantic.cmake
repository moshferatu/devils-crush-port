foreach(required_variable IN ITEMS APP CONFIG ROM OUTPUT)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required.")
    endif()
endforeach()
if(NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Unsupported Three-Blobs first-movement prefix configuration: ${CONFIG}")
endif()
set(expected_census_sha256 "9036a9de0c3c9917f47bff8c04c136a4824ec12601fb457d260aa2dfe4443490")
set(expected_call_sha256 "9aba01ebbd5bddd19e38ad7ec08eb8769649c7f6e84fa769e9a21f6c14cb8799")
set(expected_write_sha256 "98924d6a4fc5043ff18a1abe77cbc36785c52741def7514d16a8bd5f78e208a1")
set(call_output "${OUTPUT}.calls.csv")
set(write_output "${call_output}.writes.csv")
execute_process(COMMAND "${APP}" --record-state-census "${OUTPUT}" --observe-hook "03:66A3" --replace-hook "03:66A3@all" --routine-call-trace "${call_output}" --routine-replay "03:66A3@1" --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Semantic Three-Blobs first-movement prefix recorder failed (${result}).\n${out}${err}")
endif()
# The dispatcher now also handles 91 short-horizon entries through the exact
# core DEC capability. They count as native entries, not full native prefixes;
# the original census, call/register/timing and ordered-write goldens below
# are unchanged and remain the behavioral oracle.
foreach(line IN ITEMS "Native replacement 03:66A3@all entries: 1107 of 1107" "Routine call trace complete: 1107 calls, 11396 writes" "Routine replay 03:66A3@1 verified: frame 1229, 282 body cycles, 6 ordered writes")
    string(FIND "${out}" "${line}" offset)
    if(offset EQUAL -1)
        message(FATAL_ERROR "Semantic Three-Blobs first-movement prefix output omitted '${line}'.\n${out}${err}")
    endif()
endforeach()
foreach(kind IN ITEMS census call write)
    if(kind STREQUAL "census")
        set(path "${OUTPUT}")
        set(expected "${expected_census_sha256}")
    elseif(kind STREQUAL "call")
        set(path "${call_output}")
        set(expected "${expected_call_sha256}")
    else()
        set(path "${write_output}")
        set(expected "${expected_write_sha256}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Semantic Three-Blobs first-movement prefix ${kind} artifact changed.")
    endif()
endforeach()
message(STATUS "Semantic 66A3 first-movement prefixes preserve direct, timer-, x-, and y-expiry calls.")
