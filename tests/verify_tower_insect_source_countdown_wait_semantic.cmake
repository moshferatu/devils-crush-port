foreach(required_variable IN ITEMS APP CONFIG ROM OUTPUT)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required.")
    endif()
endforeach()
if(NOT CONFIG STREQUAL "Release" AND NOT CONFIG STREQUAL "Debug")
    message(FATAL_ERROR "Unsupported Tower-insect source countdown configuration: ${CONFIG}")
endif()

set(expected_census_sha256 "9036a9de0c3c9917f47bff8c04c136a4824ec12601fb457d260aa2dfe4443490")
set(expected_trace_sha256 "926e0960db22ad0d9155e2763441554e5698f847003c58ebee1cb88838b203e4")
set(expected_call_sha256 "2f7675e5cbfb81c42af154daf980793e568c3bc6b47d3c7395a3da9646339c26")
set(expected_write_sha256 "272538f08055c250b8d15e359440a20d9691b3ed27232b814e1e288604c0b809")
set(trace_output "${OUTPUT}.trace.csv")
set(call_output "${OUTPUT}.calls.csv")
set(write_output "${call_output}.writes.csv")
execute_process(COMMAND "${APP}" --record-state-census "${OUTPUT}" --observe-hook "02:5F4A" --observe-hook "02:5F5B" --replace-hook "02:5F4A@all" --replace-hook "02:5F5B@all" --routine-trace "${trace_output}" --routine-call-trace "${call_output}" --routine-replay "02:5F4A@2" --routine-replay "02:5F5B@1" --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Semantic Tower-insect source countdown recorder failed (${result}).\n${out}${err}")
endif()
foreach(line IN ITEMS "Native replacement 02:5F4A@all entries: 141 of 145" "Native replacement 02:5F5B@all entries: 3 of 3" "Observe hook 1 entries: 145" "Observe hook 2 entries: 3" "Routine trace complete: 148 entries" "Routine call trace complete: 148 calls, 500 writes" "Routine replay 02:5F4A@2 verified: frame 942, 33 body cycles, 1 ordered writes" "Routine replay 02:5F5B@1 verified: frame 941, 0 body cycles, 0 ordered writes" "Routine replay complete: 2 state-normalized calls")
    string(FIND "${out}" "${line}" offset)
    if(offset EQUAL -1)
        message(FATAL_ERROR "Semantic Tower-insect source countdown output omitted '${line}'.\n${out}${err}")
    endif()
endforeach()
foreach(artifact IN ITEMS census trace call write)
    if(artifact STREQUAL "census")
        set(path "${OUTPUT}")
    elseif(artifact STREQUAL "trace")
        set(path "${trace_output}")
    elseif(artifact STREQUAL "call")
        set(path "${call_output}")
    else()
        set(path "${write_output}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL "${expected_${artifact}_sha256}")
        message(FATAL_ERROR "Semantic Tower-insect source countdown ${artifact} artifact changed.")
    endif()
endforeach()
