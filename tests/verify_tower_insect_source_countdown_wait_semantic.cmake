foreach(required_variable IN ITEMS APP CONFIG ROM OUTPUT)
    if(NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required.")
    endif()
endforeach()
if(NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Tower-insect source countdown regression is Release-only.")
endif()

set(expected_census_sha256 "9036a9de0c3c9917f47bff8c04c136a4824ec12601fb457d260aa2dfe4443490")
set(expected_trace_sha256 "0c161dfffbbbbad52c7cee879079b2ed6bab513ab5fc737453223c14e4463f15")
set(expected_call_sha256 "41b7e85077693f97ee39b03a2416978c77becf0659fd8c1211864c8297b20f18")
set(expected_write_sha256 "d3d2b806dd923a6451f47a9995305aa4ad3375ca7236fcdfaf01f92d80ffe8b4")
set(trace_output "${OUTPUT}.trace.csv")
set(call_output "${OUTPUT}.calls.csv")
set(write_output "${call_output}.writes.csv")
execute_process(COMMAND "${APP}" --record-state-census "${OUTPUT}" --observe-hook "02:5F4A" --observe-hook "02:5F5F" --replace-hook "02:5F4A@all" --routine-trace "${trace_output}" --routine-call-trace "${call_output}" --routine-replay "02:5F4A@2" --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Semantic Tower-insect source countdown recorder failed (${result}).\n${out}${err}")
endif()
foreach(line IN ITEMS "Native replacement 02:5F4A@all entries: 141 of 145" "Observe hook 1 entries: 145" "Observe hook 2 entries: 2504" "Routine trace complete: 2649 entries" "Routine call trace complete: 2649 calls, 722 writes" "Routine replay 02:5F4A@2 verified: frame 942, 33 body cycles, 1 ordered writes")
    string(FIND "${out}" "${line}" offset)
    if(offset EQUAL -1)
        message(FATAL_ERROR "Semantic Tower-insect source countdown output omitted '${line}'.\n${out}${err}")
    endif()
endforeach()
foreach(artifact IN ITEMS census trace call write)
    if(artifact STREQUAL "census")
        set(path "${OUTPUT}")
    elseif(artifact STREQUAL "trace")
        set(path "${trace_output}")
    elseif(artifact STREQUAL "call")
        set(path "${call_output}")
    else()
        set(path "${write_output}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL "${expected_${artifact}_sha256}")
        message(FATAL_ERROR "Semantic Tower-insect source countdown ${artifact} artifact changed.")
    endif()
endforeach()
