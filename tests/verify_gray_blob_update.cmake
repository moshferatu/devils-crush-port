foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" instructions OFFSET 26815 LIMIT 31 HEX)
if(NOT instructions STREQUAL "de003ad00da9049d003abd803949019d8039bd003810034c0669de803bd027")
    message(FATAL_ERROR "Gray-Blob update ROM instructions changed")
endif()
file(READ "${ROM}" return_instruction OFFSET 26885 LIMIT 1 HEX)
if(NOT return_instruction STREQUAL "60")
    message(FATAL_ERROR "Gray-Blob return at 6905 must be RTS")
endif()
set(expected_csv "97f5089683bb67c53a3755a2d320ce1bcf5ea5e347d65200373a3f22b69cbc4b")
set(expected_writes.csv "fc4c6fb06455061a5ec54cb537dafafe3719ec5b90728b1599c4095dc7022de0")
set(expected_bus.csv "448e48f3a7da69a50fc708f62a33177e9b3b997ef3c6986fbaf2beb24cba3f4d")
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "03:68BF@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay "${base}.csv" ${hooks}
        --work-ram-patch "1300:2CC0:80"
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Gray-Blob ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        set(expected "Native replacement 03:68BF@all entries: 492 of 492")
        string(FIND "${output}" "${expected}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing admission ${expected}: ${output}")
        endif()
        message(STATUS "${expected}")
    endif()
endforeach()
foreach(suffix IN ITEMS csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement OR NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Gray-Blob ${suffix}: ${original} != ${replacement} or pinned baseline")
    endif()
    message(STATUS "${suffix}: ${original}")
endforeach()