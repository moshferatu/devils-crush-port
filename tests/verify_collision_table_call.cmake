foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" instructions OFFSET 17438 LIMIT 6 HEX)
if(NOT instructions STREQUAL "bd803c206669")
    message(FATAL_ERROR "Collision selector/call ROM instructions changed")
endif()
set(expected_csv "a3f53fa89b15c342ca401860e717a93db85fc1f65784f36eb8d52572f1b1fd23")
set(expected_calls.csv "da52986a9fba01e7c17c31b6af0a11ac6029bcf70e7e971436b895e3824dc10b")
set(expected_calls.csv.writes.csv "d42539511303d2a251d6d08a781d632870d31193f50ac49d6f87464fc0572d63")
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "02:441E@all" --replace-hook "02:4421@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay-weave "${base}.csv" ${hooks}
        --observe-hook "02:441E" --observe-hook "02:4421"
        --routine-call-trace "${base}.calls.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Collision call ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        foreach(expected IN ITEMS "Native replacement 02:441E@all entries: 329 of 329"
                                  "Native replacement 02:4421@all entries: 285 of 329"
                                  "Routine call trace complete: 658 calls, 21092 writes")
            string(FIND "${output}" "${expected}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing ${expected}: ${output}")
            endif()
            message(STATUS "${expected}")
        endforeach()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement OR NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Collision call ${suffix}: ${original} != ${replacement} or pinned baseline")
    endif()
    message(STATUS "${suffix}: ${original}")
endforeach()
