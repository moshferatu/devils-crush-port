foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" instructions OFFSET 26278 LIMIT 2 HEX)
if(NOT instructions STREQUAL "d00d")
    message(FATAL_ERROR "Three-Blobs timer branch ROM instructions changed")
endif()
set(expected_csv "9036a9de0c3c9917f47bff8c04c136a4824ec12601fb457d260aa2dfe4443490")
set(expected_writes.csv "2061f481a31f4fde9b12877df8aecc25b23b52205be0b208e9476417f938f620")
set(expected_bus.csv "5a8a45526ec153e2bfd8921b081719f216ad93cd5d10f78da86074405a9922cd")
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "03:66A6@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-state-census "${base}.csv" ${hooks}
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Three-Blobs timer branch ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        set(expected "Native replacement 03:66A6@all entries: 1107 of 1107")
        string(FIND "${output}" "${expected}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing admission ${expected}: ${output}")
        endif()
        message(STATUS "${expected}")
    endif()
endforeach()
foreach(suffix IN ITEMS csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement OR NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Three-Blobs timer branch ${suffix}: ${original} != ${replacement} or pinned baseline")
    endif()
    message(STATUS "${suffix}: ${original}")
endforeach()