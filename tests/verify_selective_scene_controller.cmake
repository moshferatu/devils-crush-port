foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
foreach(route IN ITEMS alternate twist seeded)
    set(record --record-gameplay-${route})
    set(patches)
    if(route STREQUAL "seeded")
        set(record --record-state-census)
        set(patches --work-ram-patch "3000:3380:03" --work-ram-patch "3000:3300:00")
    endif()
    foreach(mode IN ITEMS assembly native)
        set(hooks)
        if(mode STREQUAL "native")
            set(hooks --replace-hook "02:40A8@all" --replace-hook "02:40BD@all")
        endif()
        set(base "${OUTPUT}.${route}.${mode}")
        execute_process(COMMAND "${APP}" ${record} "${base}.csv" ${patches} ${hooks}
            --observe-hook "02:40A8" --routine-call-trace "${base}.calls.csv"
            --bus-write-range 0000-0003 --bus-write-trace "${base}.bus.csv"
            --rom "${ROM}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Selective controller ${route}/${mode}: ${output}${error}")
        endif()
        if(mode STREQUAL "native")
            foreach(expected IN ITEMS
                "Native replacement 02:40A8@all entries: 1 of 1"
                "Native replacement 02:40BD@all entries: 7 of 7")
                string(FIND "${output}" "${expected}" offset)
                if(offset EQUAL -1)
                    message(FATAL_ERROR "Entry count changed: ${output}")
                endif()
            endforeach()
            foreach(address IN ITEMS 40A8 40BD)
                if(NOT output MATCHES "Native replacement 02:${address}@all entries: ([0-9]+) of ([0-9]+)")
                    message(FATAL_ERROR "Missing admission evidence: ${output}")
                endif()
                if(NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2 OR CMAKE_MATCH_1 EQUAL 0)
                    message(FATAL_ERROR "Controller declined: ${output}")
                endif()
                message(STATUS "${route} ${address}: ${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
            endforeach()
        endif()
    endforeach()
    foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv bus.csv)
        file(SHA256 "${OUTPUT}.${route}.assembly.${suffix}" original)
        file(SHA256 "${OUTPUT}.${route}.native.${suffix}" replacement)
        if(NOT original STREQUAL replacement)
            message(FATAL_ERROR "Selective ${route} ${suffix}: ${original} != ${replacement}")
        endif()
        message(STATUS "${route} ${suffix}: ${original}")
    endforeach()
endforeach()
