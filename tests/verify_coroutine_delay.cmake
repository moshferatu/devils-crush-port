# Compare the delay scheduler's stack-consuming indirect jump with assembly.
set(expected_csv "1f6d46ac99798bbac1ecab97702d9e10076b9766796cc64d22d9662efce0b353")
set(expected_calls.csv "740eedd7d8cf9cebc8470e45bd57473e007c003cee73e1aeb75b98d20d251633")
set(expected_calls.csv.writes.csv "2ae87963b60b880c689648a0366f6457096adc13466e57b275087ed5592d4b95")
set(expected_writes.csv "da606d14dd48b5b73e86096ba4033c6bf40c67e97ea771e5705760a02bbe3e1c")
set(expected_bus.csv "e1dcf4b4a41dcf07638356bfddf934265291648adef9022ff4799f716e5e7a46")
foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" scheduler_bytes OFFSET 9706 LIMIT 28 HEX)
if(NOT scheduler_bytes STREQUAL "9d803d68852f688530e62fd002e630a52f9d003fa5309d803f6c2f20")
    message(FATAL_ERROR "Unsupported delay scheduler ROM instructions")
endif()
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "01:C5EA@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay "${base}.csv" ${hooks}
        --observe-hook "01:C5EA"
        --routine-call-trace "${base}.calls.csv"
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Coroutine delay ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        string(REGEX MATCH "Native replacement 01:C5EA@all entries: [0-9]+ of [0-9]+" admission "${output}")
        if(NOT admission)
            message(FATAL_ERROR "Missing Coroutine delay admission: ${output}")
        endif()
        message(STATUS "${admission}")
        if(NOT admission STREQUAL "Native replacement 01:C5EA@all entries: 2 of 2")
            message(FATAL_ERROR "Coroutine delay admission changed: ${admission}")
        endif()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement)
        message(FATAL_ERROR "Coroutine delay ${suffix}: ${original} != ${replacement}")
    endif()
    if(NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Coroutine delay ${suffix} assembly baseline changed: ${original}")
    endif()
    message(STATUS "${suffix}: ${original}")
endforeach()
