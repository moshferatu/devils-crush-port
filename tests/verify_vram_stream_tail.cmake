# Compare VRAM stream loop and return boundaries, including live caller observations.
set(expected_calls.csv "a49c7c863c53f903e9de9e5e548490fe4460bf098157ec15ed8096ae69de3b3f")
set(expected_calls.csv.writes.csv "97a8d5239d701e9b1d896bd38be56704c95d43d83ed57e27382db10b334d9c4d")
set(expected_csv "1f6d46ac99798bbac1ecab97702d9e10076b9766796cc64d22d9662efce0b353")
set(expected_writes.csv "da606d14dd48b5b73e86096ba4033c6bf40c67e97ea771e5705760a02bbe3e1c")
set(expected_bus.csv "e1dcf4b4a41dcf07638356bfddf934265291648adef9022ff4799f716e5e7a46")
foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" branch_bytes OFFSET 1145 LIMIT 2 HEX)
file(READ "${ROM}" return_bytes OFFSET 1148 LIMIT 1 HEX)
if(NOT branch_bytes STREQUAL "80bd" OR NOT return_bytes STREQUAL "60")
    message(FATAL_ERROR "Unsupported VRAM stream tail ROM instructions")
endif()
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "00:E479@all" --replace-hook "00:E47C@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay "${base}.csv" ${hooks}
        --observe-hook "00:E47C" --observe-hook "00:E41F"
        --routine-call-trace "${base}.calls.csv"
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "VRAM stream tail ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        foreach(expected IN ITEMS "Native replacement 00:E479@all entries: 6321 of 6773"
                                  "Native replacement 00:E47C@all entries: 20 of 20")
            string(FIND "${output}" "${expected}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing admission ${expected}: ${output}")
            endif()
            message(STATUS "${expected}")
        endforeach()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement)
        message(FATAL_ERROR "VRAM stream tail ${suffix}: ${original} != ${replacement}")
    endif()
    message(STATUS "${suffix}: ${original}")
    if(NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "VRAM stream tail ${suffix} assembly baseline changed: ${original}")
    endif()
endforeach()
