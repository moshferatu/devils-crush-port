if(NOT DEFINED ROUTES)
    set(ROUTES gameplay alternate alley)
endif()
foreach(route IN LISTS ROUTES)
    set(flag "--record-gameplay-${route}")
    if(route STREQUAL "gameplay")
        set(flag --record-gameplay)
    endif()
    if(route STREQUAL "gameplay")
        set(expected 14)
    elseif(route STREQUAL "alternate")
        set(expected 190)
    elseif(route STREQUAL "alley")
        set(expected 250)
    else()
        message(FATAL_ERROR "No admission baseline for ${route}")
    endif()
    foreach(mode IN ITEMS assembly native)
        set(hooks)
        if(mode STREQUAL "native")
            set(hooks --replace-hook "02:5475@all" --replace-hook "02:5481@all")
        endif()
        set(base "${OUTPUT}.${route}.${mode}")
        execute_process(COMMAND "${APP}" ${flag} "${base}.csv"
            ${hooks} --observe-hook "02:5475" --routine-call-trace "${base}.calls.csv"
            --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
            --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${route}/${mode}: ${output}${error}")
        endif()
        if(mode STREQUAL "native")
            foreach(pc IN ITEMS 5475 5481)
                string(REGEX MATCH "Native replacement 02:${pc}@all entries: ([0-9]+) of ([0-9]+)" admission "${output}")
                if(NOT admission OR NOT CMAKE_MATCH_1 EQUAL expected OR NOT CMAKE_MATCH_2 EQUAL expected)
                    message(FATAL_ERROR "Incomplete appearance admission: ${output}")
                endif()
                message(STATUS "${route}: ${admission}")
            endforeach()
        endif()
    endforeach()
    foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv bus.csv)
        file(SHA256 "${OUTPUT}.${route}.assembly.${suffix}" original)
        file(SHA256 "${OUTPUT}.${route}.native.${suffix}" replacement)
        if(NOT original STREQUAL replacement)
            message(FATAL_ERROR "Appearance ${route}/${suffix}: ${original} != ${replacement}")
        endif()
    endforeach()
    if(route STREQUAL "alley")
        # 68 calls use the deeper stack frame rejected by the old guard.
        file(STRINGS "${OUTPUT}.${route}.assembly.calls.csv" deeper_calls
            REGEX ",0E,[0-9A-F][0-9A-F],F9,")
        list(LENGTH deeper_calls deeper_count)
        if(NOT deeper_count EQUAL 68)
            message(FATAL_ERROR "Missing deeper caller coverage: ${deeper_count}")
        endif()
    endif()
endforeach()
