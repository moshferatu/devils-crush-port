foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "02:4F3D@all" --replace-hook "02:4F6C@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-state-census "${base}.csv"
        --work-ram-patch "1200:2D20:01" ${hooks}
        --observe-hook "02:4F3D" --routine-call-trace "${base}.calls.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        string(FIND "${output}" "Native replacement 02:4F3D@all entries: 224 of 224" admitted)
        if(admitted EQUAL -1)
            message(FATAL_ERROR "Incomplete admission: ${output}")
        endif()
        string(REGEX MATCH "Native replacement 02:4F6C@all entries: ([0-9]+) of ([0-9]+)" countdown "${output}")
        if(NOT countdown OR CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
            message(FATAL_ERROR "Incomplete countdown admission: ${output}")
        endif()
    endif()
endforeach()
file(STRINGS "${OUTPUT}.native.calls.csv.writes.csv" expiry REGEX ",02,4F76,")
if(NOT expiry)
    message(FATAL_ERROR "Eyeball replay did not exercise expiry")
endif()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement)
        message(FATAL_ERROR "Eyeball ${suffix}: ${original} != ${replacement}")
    endif()
endforeach()
