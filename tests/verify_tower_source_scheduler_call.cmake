foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" instructions OFFSET 24435 LIMIT 3 HEX)
if(NOT instructions STREQUAL "2018c0")
    message(FATAL_ERROR "Tower source scheduler call ROM instructions changed")
endif()
set(expected_csv "77568124b24b80006d3077da8fcf0df21706c5627278e4c7bc92f645e56773cf")
set(expected_calls.csv "df29586f61f3ce2745cf3e0a98c86624dbd63fa578585b84708b1e13bf6c5c9a")
set(expected_calls.csv.writes.csv "a997f01b67b11f6f724e9ba5cc192516b6633fdc5d7a3329552f7862e9d72521")
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "02:5F73@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay-higharc "${base}.csv" ${hooks}
        --observe-hook "02:5F73" --observe-hook "01:C5C9"
        --routine-call-trace "${base}.calls.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Tower source scheduler call ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        foreach(expected IN ITEMS "Native replacement 02:5F73@all entries: 192 of 192"
                                  "Routine call trace complete: 1635 calls, 818325 writes")
            string(FIND "${output}" "${expected}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing ${expected}: ${output}")
            endif()
            message(STATUS "${expected}")
        endforeach()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement OR NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Tower source scheduler call ${suffix}: ${original} != ${replacement} or pinned baseline")
    endif()
    message(STATUS "${suffix}: ${original}")
endforeach()
