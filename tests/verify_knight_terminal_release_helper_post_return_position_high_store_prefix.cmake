foreach(v IN ITEMS APP CONFIG ROM OUTPUT)
    if(NOT DEFINED ${v} OR "${${v}}" STREQUAL "")
        message(FATAL_ERROR "${v} is required.")
    endif()
endforeach()
if(NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "Release-only regression.")
endif()
set(expected_census_sha256 "5bee19b564a4e54444f444fdaf156fcec1385fbca952abf8b531b910eeb75243")
set(expected_call_sha256 "1f90ec29000056d4e75cc3200555a6f5e7ae6df093cd865d0aecd2e741ece2d6")
set(expected_write_sha256 "e01bb86143103603e96be0ca8f30dbdae6e80eaf2896de160f17797de190c97b")
set(call_output "${OUTPUT}.calls.csv")
set(write_output "${call_output}.writes.csv")
execute_process(COMMAND "${APP}" --record-state-census "${OUTPUT}" --observe-hook "02:4230" --replace-hook "02:4230@all" --routine-call-trace "${call_output}" --work-ram-patch "1228:3100:00" --work-ram-patch "1228:3180:40" --work-ram-patch "1228:3200:00" --work-ram-patch "1228:3300:00" --work-ram-patch "1228:3380:01" --work-ram-patch "1340:3100:00" --work-ram-patch "1340:3180:40" --work-ram-patch "1340:3200:00" --work-ram-patch "1340:3280:00" --work-ram-patch "1340:3300:00" --work-ram-patch "1340:3380:01" --work-ram-patch "1400:3B3A:00" --work-ram-patch "1400:3F3A:78" --work-ram-patch "1400:3FBA:73" --work-ram-patch "1400:2D06:01" --work-ram-patch "1402:3C3A:01" --work-ram-patch "1402:383A:80" --rom "${ROM}" RESULT_VARIABLE r OUTPUT_VARIABLE o ERROR_VARIABLE e)
if(NOT r EQUAL 0)
    message(FATAL_ERROR "Recorder failed (${r}).\n${o}${e}")
endif()
foreach(line IN ITEMS "Work-RAM patches applied: 17" "Native replacement 02:4230@all entries: 1 of 14" "Observe hook 1 entries: 14" "Routine call trace complete: 14 calls, 186 writes")
    string(FIND "${o}" "${line}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Output omitted '${line}'.\n${o}${e}")
    endif()
endforeach()
foreach(kind IN ITEMS census call write)
    if(kind STREQUAL "census")
        set(path "${OUTPUT}")
    elseif(kind STREQUAL "call")
        set(path "${call_output}")
    else()
        set(path "${write_output}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL "${expected_${kind}_sha256}")
        message(FATAL_ERROR "${kind} artifact changed.")
    endif()
endforeach()
