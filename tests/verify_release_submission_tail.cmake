# Compare release submission tail with assembly, including scheduler call observations.
set(expected_calls.csv "193029c595fcfc3ade895cad93b6a6569500f7727b24dac92e97f907afb47753")
set(expected_calls.csv.writes.csv "c0b9e55ee87c1d566dbc9553a7602394f10e3b3a06ca8dd54f876c8f66993a89")
set(expected_csv "ba06e5a2111b9caae6837109ba2943a093cba1d47ad57af6561c2aa721b4a15a")
set(expected_writes.csv "2215f17872d845ed21a8a0551ddf0b273bc52382bd6905529c7fca417bb754f3")
set(expected_bus.csv "d98d2bcac0655667f0d7cb7c93eb297396a436c78f19afc3b0465fb8f5c1e9a9")
foreach(required IN ITEMS APP ROM OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(READ "${ROM}" gate_bytes OFFSET 20946 LIMIT 4 HEX)
if(NOT gate_bytes STREQUAL "20755460")
    message(FATAL_ERROR "Unsupported release submission tail ROM instructions")
endif()
foreach(mode IN ITEMS assembly native)
    set(hooks)
    if(mode STREQUAL "native")
        set(hooks --replace-hook "02:51D2@all" --replace-hook "02:51D5@all")
    endif()
    set(base "${OUTPUT}.${mode}")
    execute_process(COMMAND "${APP}" --record-gameplay-alley "${base}.csv" ${hooks}
        --observe-hook "02:51AF" --observe-hook "02:51D2" --observe-hook "02:51D5" --observe-hook "02:5475"
        --routine-call-trace "${base}.calls.csv"
        --work-ram-write-range 2000-3FFF --work-ram-write-trace "${base}.writes.csv"
        --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
        --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Release submission tail ${mode}: ${output}${error}")
    endif()
    if(mode STREQUAL "native")
        foreach(expected IN ITEMS "Native replacement 02:51D2@all entries: 59 of 68" "Native replacement 02:51D5@all entries: 310 of 340")
            string(FIND "${output}" "${expected}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing admission ${expected}: ${output}")
            endif()
            message(STATUS "${expected}")
        endforeach()
    endif()
endforeach()
foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv writes.csv bus.csv)
    file(SHA256 "${OUTPUT}.assembly.${suffix}" original)
    file(SHA256 "${OUTPUT}.native.${suffix}" replacement)
    if(NOT original STREQUAL replacement)
        message(FATAL_ERROR "Release submission tail ${suffix}: ${original} != ${replacement}")
    endif()
    message(STATUS "${suffix}: ${original}")
    if(NOT original STREQUAL "${expected_${suffix}}")
        message(FATAL_ERROR "Release submission tail ${suffix} assembly baseline changed: ${original}")
    endif()
endforeach()
