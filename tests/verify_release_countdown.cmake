foreach(route IN ITEMS alley)
    set(flag "--record-gameplay-${route}")
    if(route STREQUAL "gameplay")
        set(flag --record-gameplay)
    endif()
    foreach(mode IN ITEMS assembly native)
        set(hooks)
        if(mode STREQUAL "native")
            set(hooks --replace-hook "02:51AF@all")
        endif()
        set(base "${OUTPUT}.${route}.${mode}")
        execute_process(COMMAND "${APP}" ${flag} "${base}.csv"
            ${hooks} --observe-hook "02:51AF" --routine-call-trace "${base}.calls.csv"
            --bus-write-range 0000-1FFF --bus-write-trace "${base}.bus.csv"
            --rom "${ROM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${route}/${mode}: ${output}${error}")
        endif()
        if(mode STREQUAL "native")
            string(REGEX MATCH "Native replacement 02:51AF@all entries: ([0-9]+) of ([0-9]+)" admission "${output}")
            string(FIND "${output}" "Native replacement 02:51AF@all entries: 340 of 340" exact_admission)
            if(exact_admission LESS 0)
                message(FATAL_ERROR "Release countdown admission baseline changed: ${output}")
            endif()
            if(NOT admission OR CMAKE_MATCH_1 EQUAL 0 OR NOT CMAKE_MATCH_1 EQUAL CMAKE_MATCH_2)
                message(FATAL_ERROR "Incomplete release countdown admission: ${output}")
            endif()
            message(STATUS "${route}: ${admission}")
        endif()
    endforeach()
    foreach(suffix IN ITEMS csv calls.csv calls.csv.writes.csv bus.csv)
        file(SHA256 "${OUTPUT}.${route}.assembly.${suffix}" original)
        file(SHA256 "${OUTPUT}.${route}.native.${suffix}" replacement)
        if(NOT original STREQUAL replacement)
            message(FATAL_ERROR "Release countdown ${route}/${suffix}: ${original} != ${replacement}")
        endif()
    endforeach()
    file(STRINGS "${OUTPUT}.${route}.assembly.calls.csv.writes.csv" expiry REGEX ",02,51C8,1980,")
    list(LENGTH expiry expiry_count)
    if(NOT expiry_count EQUAL 68)
        message(FATAL_ERROR "Missing expiry/shared appearance coverage: ${expiry_count}")
    endif()
endforeach()
