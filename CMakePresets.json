{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-vs2022",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "DC_BUILD_APP": "ON",
        "DC_BUILD_TESTS": "ON",
        "DC_FETCH_SDL": "ON",
        "DC_FETCH_BEETLE": "ON"
      }
    },
    {
      "name": "windows-core-only",
      "displayName": "Windows x64 - Core and tests only",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-core-only",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "DC_BUILD_APP": "OFF",
        "DC_BUILD_TESTS": "ON",
        "DC_FETCH_SDL": "OFF",
        "DC_FETCH_BEETLE": "OFF"
      }
    },
    {
      "name": "windows-cabinet",
      "displayName": "Windows x64 - Cabinet deployment build",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-cabinet",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "DC_BUILD_APP": "ON",
        "DC_BUILD_TESTS": "OFF",
        "DC_FETCH_SDL": "ON",
        "DC_FETCH_BEETLE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-core-debug",
      "configurePreset": "windows-core-only",
      "configuration": "Debug"
    },
    {
      "name": "windows-cabinet",
      "configurePreset": "windows-cabinet",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-core-debug",
      "configurePreset": "windows-core-only",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
