+void HuC6280::DcObserveIrq(DcIrqObservation* const out) const
+{
+	out->timestamp = timestamp;
+	out->timer_lastts = timer_lastts;
+	out->timer_div = timer_div;
+	out->timer_value = timer_value;
+	out->timer_load = timer_load;
+	out->timer_status = timer_status;
+	out->timer_inreload = timer_inreload;
+	out->irq_low = IRQlow;
+	out->irq_mask = IRQMask;
+	out->irq_sample = IRQSample;
+	out->next_event = next_event;
+}
