+	const auto dc_run_native_block_move = [this](uint8 opcode) -> bool
+	{
+		static_assert(IBM_TIA == 1 && IBM_TAI == 2 && IBM_TDD == 3
+			&& IBM_TII == 4 && IBM_TIN == 5, "Block-move savestate ABI");
+		dc_beetle_execution_owner = DC_EXEC_TRANSLATED;
