+	}
+	// A live boundary-model handoff can resume a native-started transfer in
+	// the original engine without loading a state. Its new work is fallback.
+	if(in_block_move && dc_beetle_execution_block_owner == DC_EXEC_TRANSLATED)
+		dc_beetle_execution_block_owner = DC_EXEC_FALLBACK;
