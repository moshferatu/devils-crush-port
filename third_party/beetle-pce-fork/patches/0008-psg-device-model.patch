+// Devil's Crush downstream device-model boundary. Plain field moves, with no
+// repair of out-of-range values: on save the model's own state is already
+// valid, and on load StateAction has already applied the emulator's repairs
+// before these values are read back out.
+void PCE_PSG::DcExportState(dc_beetle_psg_state* state) const
+{
+	for(int ch = 0; ch < 6; ch++)
+	{
+		const psg_channel* pt = &channel[ch];
+		dc_beetle_psg_channel_state* out = &state->channels[ch];
+
+		out->counter = pt->counter;
+		out->frequency = pt->frequency;
+		out->control = pt->control;
+		out->balance = pt->balance;
+		memcpy(out->waveform, pt->waveform, 32);
+		out->waveform_index = pt->waveform_index;
+		out->dda = pt->dda;
+		out->noisectrl = pt->noisectrl;
+		out->noisecount = pt->noisecount;
+		out->lfsr = pt->lfsr;
+		out->vl[0] = pt->vl[0];
+		out->vl[1] = pt->vl[1];
+	}
+
+	state->select = select;
+	state->global_balance = globalbalance;
+	state->lfo_frequency = lfofreq;
+	state->lfo_control = lfoctrl;
+	state->volume_update_counter = vol_update_counter;
+	state->volume_update_which = vol_update_which;
+	state->volume_update_latch = vol_update_vllatch;
+	state->volume_update_pending = vol_pending ? 1 : 0;
+}
+
+void PCE_PSG::DcImportState(const dc_beetle_psg_state* state)
+{
+	for(int ch = 0; ch < 6; ch++)
+	{
+		psg_channel* pt = &channel[ch];
+		const dc_beetle_psg_channel_state* in = &state->channels[ch];
+
+		pt->counter = in->counter;
+		pt->frequency = in->frequency;
+		pt->control = in->control;
+		pt->balance = in->balance;
+		memcpy(pt->waveform, in->waveform, 32);
+		pt->waveform_index = in->waveform_index;
+		pt->dda = in->dda;
+		pt->noisectrl = in->noisectrl;
+		pt->noisecount = in->noisecount;
+		pt->lfsr = in->lfsr;
+		pt->vl[0] = in->vl[0];
+		pt->vl[1] = in->vl[1];
+	}
+
+	select = state->select;
+	globalbalance = state->global_balance;
+	lfofreq = state->lfo_frequency;
+	lfoctrl = state->lfo_control;
+	vol_update_counter = state->volume_update_counter;
+	vol_update_which = state->volume_update_which;
+	vol_update_vllatch = state->volume_update_latch;
+	vol_pending = state->volume_update_pending != 0;
+}
