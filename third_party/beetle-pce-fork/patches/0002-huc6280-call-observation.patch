+uint32 HuC6280::GetMasterCyclesUntilTimerInterrupt(void) const
+{
+	const uint32 no_interrupt = 0xFFFFFFFFU;
+	int64 remaining;
+	int64 horizon;
+
+	if((P & I_FLAG) || !(IRQMask & IQTIMER))
+		return no_interrupt;
+	if(IRQlow & IQTIMER)
+		return 0;
+	if(!timer_status)
+		return no_interrupt;
+
+	remaining = (int64)timer_div - ((int64)timestamp - timer_lastts);
+	if(remaining < 0)
+		remaining = 0;
+	if(timer_inreload)
+		horizon = remaining + 3071 + (int64)timer_load * 3072;
+	else
+		horizon = remaining + (int64)timer_value * 3072;
+
+	if(horizon < 0)
+		return 0;
+	if(horizon > no_interrupt)
+		return no_interrupt;
+	return (uint32)horizon;
+}
