+void VCE::DcObserve(DcObservation* const out) const
+{
+	out->clock_divider  = clock_divider;
+	out->child_event[0] = child_event[0];
+	out->child_event[1] = child_event[1];
+	out->cd_event       = cd_event;
+	out->scanline       = scanline;
+	out->pixel_offset   = pixel_offset;
+	out->hblank_counter = hblank_counter;
+	out->vblank_counter = vblank_counter;
+	out->ws_counter     = ws_counter;
+	out->ctaddress      = ctaddress;
+	out->cr             = CR;
+	out->hblank         = hblank;
+	out->vblank         = vblank;
+	out->need_sl_reset  = NeedSLReset;
+	out->frame_done     = FrameDone;
+}
+
+int32 VCE::DcSyncReal(const int32 timestamp)
+{
+	return SyncReal(timestamp);
+}
+
+int32 VCE::DcCalcNextEvent(void)
+{
+	return CalcNextEvent();
+}
+
+void VCE::DcResetWaitStates(void)
+{
+	ws_counter = 0;
+}
+
+uint32 VCE::DcSurfClut(const unsigned index, const unsigned entry) const
+{
+	return surf_clut[index & 1][entry & 0x1FF];
+}
+
+uint32 VCE::DcColorTableCache(const unsigned entry) const
+{
+	return color_table_cache[entry & 0x3FF];
+}
