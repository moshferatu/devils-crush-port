diff --git a/mednafen/pce/vce.h b/mednafen/pce/vce.h
--- a/mednafen/pce/vce.h
+++ b/mednafen/pce/vce.h
@@ -114,6 +114,40 @@ public:
 
 	int32 SyncReal(const int32 timestamp);
 	
+	// Devil's Crush downstream reference-observation boundary. The encoder's
+	// schedule is entirely private, and a differential test that could only
+	// compare pixels would report "the picture moved" for any of a dozen
+	// causes. These read that state and change none of it; the two that do
+	// change something reproduce what `RunPartial` does to the stall budget
+	// and what the register file's callers do with the next event, both of
+	// which a test driving this device without a processor has to do itself.
+	struct DcObservation
+	{
+		int32 clock_divider;
+		int32 child_event[2];
+		int32 cd_event;
+		int32 scanline;
+		int32 pixel_offset;
+		int32 hblank_counter;
+		int32 vblank_counter;
+		int32 ws_counter;
+		uint16 ctaddress;
+		uint8 cr;
+		bool hblank;
+		bool vblank;
+		bool need_sl_reset;
+		bool frame_done;
+	};
+
+	void DcObserve(DcObservation* out) const;
+	// `SyncReal` is inlined into the one caller `vce.cpp` has and emits no
+	// out-of-line body, so a caller outside the file needs this.
+	int32 DcSyncReal(const int32 timestamp);
+	int32 DcCalcNextEvent(void);
+	void DcResetWaitStates(void);
+	uint32 DcSurfClut(unsigned index, unsigned entry) const;
+	uint32 DcColorTableCache(unsigned entry) const;
+
