+	// Devil's Crush downstream observation. The decision an instruction
+	// boundary makes, named and lifted out of the loop that acts on it.
+	//
+	// The lifting is the whole of this patch's behaviour. `LastCycle`
+	// latches through `DcSampleInterrupt` and `RunSub` asks
+	// `DcSelectInterrupt` and then does what the answer says, so a
+	// differential test drives the machine's own rule rather than a copy of
+	// it that could drift away from it later.
+	enum DcInterruptDecision
+	{
+		DC_INTERRUPT_INSTRUCTION = 0,
+		DC_INTERRUPT_RESET = 1,
+		DC_INTERRUPT_TIMER = 2,
+		DC_INTERRUPT_IRQ1 = 3,
+		DC_INTERRUPT_IRQ2 = 4
+	};
+
+	// `LastCycle` without the cycle. The cycle is the processor's; these two
+	// assignments are the boundary's, and they are the only place the mask
+	// and the I flag are consulted in the past tense.
+	void INLINE DcSampleInterrupt(void)
+	{
+		IRQSample = (IRQlow & IRQMask) & PIMaskCache;
+		IFlagSample = P & I_FLAG;
+	}
+
+	// The reset line leaves the latch when the vector is taken. Only the
+	// latch: the request register and the mask are dealt with separately by
+	// both callers, because on one of the two paths they belong to an
+	// installed model rather than to this class.
+	void INLINE DcAcknowledgeInterruptSample(void)
+	{
+		IRQSample &= ~IQRESET;
+	}
+
+	DcInterruptDecision INLINE DcSelectInterrupt(void) const
+	{
+		if(!(IRQSample | IRQlow))
+			return DC_INTERRUPT_INSTRUCTION;
+
+		if(MDFN_UNLIKELY(IRQSample & IQRESET))
+			return DC_INTERRUPT_RESET;
+
+		if((IRQlow & IQTIMER & IRQMask) && !IFlagSample) //IRQSample & IQTIMER)
+			return DC_INTERRUPT_TIMER;
+
+		if(IRQSample & IQIRQ1)
+			return DC_INTERRUPT_IRQ1;
+
+		if(IRQSample & IQIRQ2)
+			return DC_INTERRUPT_IRQ2;
+
+		return DC_INTERRUPT_INSTRUCTION;
+	}
+
+	static uint32 DcInterruptVector(const DcInterruptDecision decision)
+	{
+		switch(decision)
+		{
+			case DC_INTERRUPT_RESET: return 0xFFFE;
+			case DC_INTERRUPT_TIMER: return 0xFFFA;
+			case DC_INTERRUPT_IRQ1: return 0xFFF8;
+			case DC_INTERRUPT_IRQ2: return 0xFFF6;
+			default: return 0;
+		}
+	}
+
+	// What an observer needs to see, and the two ways a test reaches the
+	// inputs. The setters write the request register and the mask directly,
+	// which is a mirror of an installed interrupt controller when one
+	// exists -- so like every other observation entry point here, they are
+	// for a device driven without a machine and not for a machine.
+	struct DcBoundaryObservation
+	{
+		uint32 irq_low;
+		uint8 irq_mask;
+		int32 irq_sample;
+		int32 i_flag_sample;
+	};
+
+	void DcObserveBoundary(DcBoundaryObservation* out) const;
+
+	void DcSetBoundaryLines(const uint32 low, const uint8 mask)
+	{
+		IRQlow = low;
+		IRQMask = mask;
+	}
+
+	void DcSetBoundarySample(const int32 sample, const int32 i_flag)
+	{
+		IRQSample = sample;
+		IFlagSample = i_flag;
+	}
