+	// A transcript that is suspended at a checkpoint while an interrupt runs
+	// is ordinary machine state, not a lock: the handler is 65C02 code like
+	// any other and may itself have a replacement. Saving the suspended
+	// transcript here lets the handler's own transcript become the current
+	// one, so the six fields above always describe the innermost body.
+	struct ReplacementFrame
+	{
+		uint32 elapsed;
+		uint32 write_index;
+		uint32 write_count;
+		uint32 checkpoint_index;
+		uint32 checkpoint_count;
+		dc_beetle_replacement_write
+			writes[DC_BEETLE_MAX_REPLACEMENT_WRITES];
+		dc_beetle_replacement_checkpoint
+			checkpoints[DC_BEETLE_MAX_REPLACEMENT_CHECKPOINTS];
+	};
+	uint32 ReplacementDepth;
+	ReplacementFrame
+		ReplacementSuspended[DC_BEETLE_MAX_REPLACEMENT_DEPTH];
+
 	bool EmulateWAI;		// For speed hacks
 };
 
