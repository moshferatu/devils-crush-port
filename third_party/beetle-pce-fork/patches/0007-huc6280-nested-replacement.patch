+// Only the used prefix of each array is live, and an interrupt handler's own
+// transcript is typically a fraction of the parent's, so saving and restoring
+// by count keeps nesting proportional to the transcripts involved rather than
+// to the fixed capacities.
+bool HuC6280::PushReplacementFrame(void)
+{
+	if(ReplacementDepth >= DC_BEETLE_MAX_REPLACEMENT_DEPTH)
+	{
+		dc_beetle_replacement_nest_overflows++;
+		return false;
+	}
+
+	ReplacementFrame& frame = ReplacementSuspended[ReplacementDepth];
+	frame.elapsed = ReplacementElapsed;
+	frame.write_index = ReplacementWriteIndex;
+	frame.write_count = ReplacementWriteCount;
+	frame.checkpoint_index = ReplacementCheckpointIndex;
+	frame.checkpoint_count = ReplacementCheckpointCount;
+	if(ReplacementWriteCount > 0)
+		memcpy(
+			frame.writes,
+			ReplacementWrites,
+			ReplacementWriteCount
+				* sizeof(dc_beetle_replacement_write));
+	if(ReplacementCheckpointCount > 0)
+		memcpy(
+			frame.checkpoints,
+			ReplacementCheckpoints,
+			ReplacementCheckpointCount
+				* sizeof(dc_beetle_replacement_checkpoint));
+	ReplacementDepth++;
+	dc_beetle_replacement_nested_installs++;
+	if(ReplacementDepth > dc_beetle_replacement_max_depth)
+		dc_beetle_replacement_max_depth = ReplacementDepth;
+	return true;
+}
+
+// Ends the innermost transcript, whether it completed or was abandoned, and
+// makes the transcript it interrupted current again. With nothing suspended
+// this is the original "no replacement is running" state.
+void HuC6280::PopReplacementFrame(void)
+{
+	if(ReplacementDepth == 0)
+	{
+		ReplacementActive = false;
+		return;
+	}
+
+	ReplacementDepth--;
+	const ReplacementFrame& frame = ReplacementSuspended[ReplacementDepth];
+	ReplacementElapsed = frame.elapsed;
+	ReplacementWriteIndex = frame.write_index;
+	ReplacementWriteCount = frame.write_count;
+	ReplacementCheckpointIndex = frame.checkpoint_index;
+	ReplacementCheckpointCount = frame.checkpoint_count;
+	if(frame.write_count > 0)
+		memcpy(
+			ReplacementWrites,
+			frame.writes,
+			frame.write_count
+				* sizeof(dc_beetle_replacement_write));
+	if(frame.checkpoint_count > 0)
+		memcpy(
+			ReplacementCheckpoints,
+			frame.checkpoints,
+			frame.checkpoint_count
+				* sizeof(dc_beetle_replacement_checkpoint));
+	ReplacementActive = true;
+}
