+void HuC6280::DcObserveScheduler(DcSchedulerObservation* const out) const
+{
+	out->timestamp = timestamp;
+	out->timestamp_frac = timestamp_frac;
+	out->overclock_rate = overclock_rate;
+	out->next_event = next_event;
+	out->next_user_event = next_user_event;
+	out->runrunrun = runrunrun;
+	out->speed = speed;
+	out->speed_shift_cache = speed_shift_cache;
+}
