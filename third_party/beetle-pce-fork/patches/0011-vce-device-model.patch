+// Devil's Crush downstream device-model boundary. Plain field moves, with no
+// repair of out-of-range values: on save the model's own state is already
+// valid, and on load StateAction has already applied the emulator's repairs
+// before these values are read back out.
+//
+// The derived companions of the control register -- the dot-clock ratio, the
+// line count, the black-and-white bit -- are not moved, because they are not
+// serialized. On save nothing reads them from this object; on load the
+// emulator's own `SetVCECR(CR)` has already rebuilt them here, and the model
+// rebuilds its own from the same byte.
+void VCE::DcExportVceState(dc_beetle_vce_state* const state) const
+{
+	memcpy(state->color_table, color_table, sizeof(state->color_table));
+
+	state->ws_counter = ws_counter;
+	state->clock_divider = clock_divider;
+	state->child_event[0] = child_event[0];
+	state->child_event[1] = child_event[1];
+	state->scanline = scanline;
+	state->pixel_offset = pixel_offset;
+	state->hblank_counter = hblank_counter;
+	state->vblank_counter = vblank_counter;
+	state->ctaddress = ctaddress;
+	state->cr = CR;
+	state->hblank = hblank;
+	state->vblank = vblank;
+	state->need_sl_reset = NeedSLReset;
+}
+
+void VCE::DcImportVceState(const dc_beetle_vce_state* const state)
+{
+	memcpy(color_table, state->color_table, sizeof(color_table));
+
+	ws_counter = state->ws_counter;
+	clock_divider = state->clock_divider;
+	child_event[0] = state->child_event[0];
+	child_event[1] = state->child_event[1];
+	scanline = state->scanline;
+	pixel_offset = state->pixel_offset;
+	hblank_counter = state->hblank_counter;
+	vblank_counter = state->vblank_counter;
+	ctaddress = state->ctaddress;
+	CR = state->cr;
+	hblank = state->hblank != 0;
+	vblank = state->vblank != 0;
+	NeedSLReset = state->need_sl_reset != 0;
+}
