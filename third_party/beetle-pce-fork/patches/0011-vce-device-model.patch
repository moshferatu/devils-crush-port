+// The controller as an installed encoder reaches it. Every one of these
+// dispatches through the same `DcVDC_*` the schedule here uses, so a native
+// encoder finds the native controller when one is installed and the
+// emulator's chip when none is -- and the two models can be installed in
+// either order, or one without the other.
+//
+// A null encoder means no machine has been built yet. The values returned
+// then are the ones the schedule would find least surprising: an event
+// horizon of one clock, a read of the open bus.
+int32_t dc_beetle_vce_vdc_reset(void)
+{
+	return (vce != NULL) ? vce->DcVdcReset() : 1;
+}
