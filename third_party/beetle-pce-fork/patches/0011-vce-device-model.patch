+// The four machine edges an installed encoder reaches back through. Each is
+// one line of what the emulator's own encoder does in the same place; there
+// is no state here, which is the point -- an encoder model owns everything
+// except the machine it is bolted to.
+void dc_beetle_vce_irq(const int raised)
+{
+	if(raised)
+		HuCPU.IRQBegin(HuC6280::IQIRQ1);
+	else
+		HuCPU.IRQEnd(HuC6280::IQIRQ1);
+}
