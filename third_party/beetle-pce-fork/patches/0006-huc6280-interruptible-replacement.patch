+void HuC6280::AdvanceReplacementTo(
+	const uint32 master_cycle_offset,
+	const dc_beetle_replacement_checkpoint* const completed_checkpoint)
+{
+	while(ReplacementWriteIndex < ReplacementWriteCount)
+	{
+		const dc_beetle_replacement_write& write =
+			ReplacementWrites[ReplacementWriteIndex];
+		if(write.master_cycle_offset > master_cycle_offset
+			|| (write.master_cycle_offset == master_cycle_offset
+				&& completed_checkpoint != NULL
+				&& (write.instruction_physical_bank
+						!= completed_checkpoint
+							->instruction_physical_bank
+					|| write.instruction_logical_pc
+						!= completed_checkpoint
+							->instruction_logical_pc)))
+			break;
+		// IOWrite steals a CPU cycle for the two hardware-page register
+		// files whose devices arbitrate the bus: the VDC base ports at
+		// $0000-$0003 and the VCE at $0400-$0405. A transcript prices that
+		// steal into the instruction, so advance to the cycle before the
+		// write and let the steal land inside the declared offset instead
+		// of past it.
+		const bool bounded_stalling_port =
+			MPR[write.logical_address >> 13] == 0xFF
+			&& (write.logical_address <= 0x0003
+				|| (write.logical_address >= 0x0400
+					&& write.logical_address <= 0x0405));
+		const uint32 port_wait =
+			bounded_stalling_port ? (3U << speed_shift_cache) : 0U;
+		if(write.master_cycle_offset < port_wait)
+		{
+			ReplacementActive = false;
+			return;
+		}
+		const uint32 advance_offset =
+			write.master_cycle_offset - port_wait;
+		if(advance_offset < ReplacementElapsed)
+		{
+			ReplacementActive = false;
+			return;
+		}
+		if(advance_offset > ReplacementElapsed)
+			ADDCYC_MASTER(advance_offset - ReplacementElapsed);
+		ReplacementElapsed = write.master_cycle_offset;
+		HookInstructionPC = write.instruction_logical_pc;
+		HookInstructionPhysicalBank =
+			write.instruction_physical_bank;
+		WrMem(write.logical_address, write.value);
+		ReplacementWriteIndex++;
+	}
+
+	if(master_cycle_offset > ReplacementElapsed)
+		ADDCYC_MASTER(master_cycle_offset - ReplacementElapsed);
+	ReplacementElapsed = master_cycle_offset;
+}
+
+void HuC6280::ApplyReplacementCheckpoint(void)
+{
+	if(!ReplacementActive
+		|| ReplacementCheckpointIndex >= ReplacementCheckpointCount)
+	{
+		ReplacementActive = false;
+		return;
+	}
+
+	const dc_beetle_replacement_checkpoint& checkpoint =
+		ReplacementCheckpoints[ReplacementCheckpointIndex];
+	AdvanceReplacementTo(
+		checkpoint.interrupt_sample_master_cycle_offset);
+
+	A = checkpoint.accumulator;
+	X = checkpoint.x;
+	Y = checkpoint.y;
+	S = checkpoint.stack_pointer;
+	P = checkpoint.status;
+	REDOPIMCACHE();
+	for(unsigned i = 0; i < 8; i++)
+		SetMPR(i, checkpoint.mpr[i]);
+
+	IRQSample = (IRQlow & IRQMask) & PIMaskCache;
+	IFlagSample = P & I_FLAG;
+
+	AdvanceReplacementTo(checkpoint.master_cycle_offset, &checkpoint);
+	HookInstructionPC = checkpoint.instruction_logical_pc;
+	HookInstructionPhysicalBank =
+		checkpoint.instruction_physical_bank;
+	PC = checkpoint.resume_logical_pc;
+
+	ReplacementCheckpointIndex++;
+	if(ReplacementCheckpointIndex >= ReplacementCheckpointCount)
+		ReplacementActive = false;
+}
